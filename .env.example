# Database connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Optional paths for MySQL backup/restore clients if Laragon's tools are not auto-detected.
# MYSQL_PATH=
# MYSQLDUMP_PATH=

# Optional account used by mysqldump when creating backups.
# mysqldump --routines may require the global SHOW_ROUTINE privilege, depending on MySQL version.
# Leave both blank to use DB_USER/DB_PASS.
BACKUP_DB_USER=
BACKUP_DB_PASS=

# Required account for importing database backups. It needs write and schema-level DDL
# privileges scoped to DB_NAME.*; do not grant GRANT OPTION or SYSTEM_USER.
# Leave the password blank only if this MySQL account has no password.
# If restore reports MySQL error 1419 with binary logging enabled, ask a DBA to
# review log_bin_trust_function_creators; do not grant SUPER to this application account.
# Error 1227 may indicate database objects owned by another account. Before importing,
# the app releases them with BACKUP_DB_USER when that account can drop views and routines
# in DB_NAME; otherwise those objects are preserved and the restore still completes.
# Do not grant SET_ANY_DEFINER or SYSTEM_USER to the application or restore account.
RESTORE_DB_USER=
RESTORE_DB_PASS=

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=LCARS

# System test only: send password reset emails immediately as well as queueing them
DIRECT_PASSWORD_RESET_EMAIL=false

# Public URL used in password reset links
APP_BASE_URL=http://localhost/library-classification-and-reporting-system

# AI book-to-course suggestions (server-side only)
AI_COURSE_ENABLED=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_RELEVANCE_MODEL=
AI_COURSE_TOP_K=5
AI_COURSE_MAX_ATTEMPTS=5
AI_COURSE_TIMEOUT_SECONDS=20
AI_COURSE_REQUESTS_PER_HOUR=10
AI_COURSE_WORKER_BATCH_SIZE=5