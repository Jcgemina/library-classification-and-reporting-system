# Composer dependencies
/vendor/

# Local environment and secrets
.env
.env.*
!.env.example

# Local runtime files
*.log
/cache/
/tmp/
/coverage/
/cachegrind.out.*
*.tmp
*.bak

# Generated analysis reports
/psalm-report.json
/security-report.json

# Uploaded prospectus documents are local application data
/uploads/prospectuses/*.pdf

# Local database backups contain application data
/backups/

# Local design tools and exploratory concepts are not application assets
/assets/
/.github/skills/
/logo-design-skill/
/assets/logo-concepts/
/assets/brand/presentation.html
/assets/brand/presentation-slides/

# Markdown notes and documentation
*.md
!markdowns/BACKUP_SETUP.md
!assets/brand/brand-guidelines.md

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node.js dependencies
/node_modules/

# Impeccable lock file for Node.js dependencies
package-lock.json

# Codex and other AI-generated files
*.codex
*.cursor
*.claude

# AI agent files
*.agent

# Local AI prompt packs, design-session state, and standalone previews
/.github/prompts/
/.impeccable/
/mockups/

# Python bytecode generated by local prompt tools
__pycache__/
*.py[cod]

# AI Test files
*.tests

# Txt files
*.txt

# Migrations files
/migrations/*

# Scripts and tests
/scripts/
/tests/